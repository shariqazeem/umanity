# ---------- Solana ----------
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com   # use a Helius/Triton RPC in production
NEXT_PUBLIC_DONATIONS_PROGRAM_ID=9JBsHFy9rQhjcPiKkFzqxpUV9HZyZ1ZmE4AWXc1Kiys1
NEXT_PUBLIC_TIPS_PROGRAM_ID=DBzVAJHgiyVWZMdj1Q2vHUfL1wW4nVag3AqJ5FKmxtau
NEXT_PUBLIC_UMANITY_ORG_WALLET=EsWeMEvuLDV2Q4CXigZbETzqXfEQwZntQjwD4Cy8AgY5
NEXT_PUBLIC_UMANITY_TREASURY=BAScBKuDXCqdHxcoqdaDrUyJtFVtjBM5wS8tLd6tsgpy
# Mainnet wallet that receives cross-chain (NEAR Intents) donations
NEXT_PUBLIC_UMANITY_CROSSCHAIN_VAULT=BAScBKuDXCqdHxcoqdaDrUyJtFVtjBM5wS8tLd6tsgpy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side signers (JSON array or base58 secret). In local dev these default to
# ~/.config/solana/devnet.json and ~/.config/solana/umanity-treasury.json
# UMANITY_AUTHORITY_KEYPAIR=
# UMANITY_TREASURY_KEYPAIR=
# UMANITY_AUTHORITY_KEYPAIR_PATH=~/.config/solana/devnet.json
# UMANITY_TREASURY_KEYPAIR_PATH=~/.config/solana/umanity-treasury.json

# ---------- Database ----------
# Unset = embedded PGlite under ./.data (local dev only).
# DATABASE_URL=postgres://umanity:umanity@localhost:5432/umanity

# ---------- Cross-chain (Aurora Intents / NEAR Intents, mainnet only) ----------
# AURORA_API_KEY=            # from https://studio.aurora.dev (fee set per key)
# ONECLICK_JWT=              # optional, https://partners.near-intents.org
# INTENTS_FEE_RECIPIENT=umanity.near   # NEAR account that receives appFees (1Click path)
INTENTS_FEE_BPS=50

# ---------- x402 (paid API access on Solana) ----------
X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_PAY_TO=              # defaults to NEXT_PUBLIC_UMANITY_TREASURY (needs a USDC ATA)
X402_PRICE_VERIFY=0.01
X402_PRICE_SPONSOR=0.05

# ---------- AI Impact Oracle ----------
# ANTHROPIC_API_KEY=
# NEAR_AI_API_KEY=           # optional: confidential TEE inference with signed responses (https://cloud.near.ai)
# NEAR_AI_MODEL=zai-org/GLM-5.1-FP8

# ---------- MultiHopper (discreet routing) ----------
# MULTIHOPPER_API_KEY=mh_test_...   # https://devnet.multihopper.com/developer/dashboard

# ---------- Optional mirrors ----------
# TAPESTRY_API_KEY=

# Multiplies every cause campaign target (lib/causes.ts). 1 on mainnet; 0.05 on devnet for testing.
CAMPAIGN_TARGET_SCALE=1

# ---------- Admin (field team) ----------
# Wallets allowed to post deliveries, upload proof media and run the bootstrap.
# The org wallet and the program authority are always admins; add more here.
# ADMIN_WALLETS=Wallet1...,Wallet2...

# ---------- Proof media storage ----------
# Default: local files under ./.data/uploads served from /api/media (mount .data as a volume on the server).
# UPLOAD_DIR=/var/lib/umanity/uploads
# S3-compatible (Cloudflare R2, S3, MinIO). Needs `npm i @aws-sdk/client-s3`; see lib/storage.ts.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=umanity-proof
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://proof.umanity.xyz
